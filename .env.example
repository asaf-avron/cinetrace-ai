# Vertex / ADK (no Gemini API key — ADC via gcloud)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=cinetrace-ai
GOOGLE_CLOUD_LOCATION=us-central1

# ClickHouse Cloud HTTPS (also used by stdio mcp-clickhouse)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_DATABASE=default

# Optional hosted MCP (OAuth). Agents use stdio mcp-clickhouse by default.
# CLICKHOUSE_MCP_URL=https://mcp.clickhouse.cloud/mcp

# Hosted Run supervisor gate (empty = fail closed unless SUPERVISOR_RUN_PUBLIC)
SUPERVISOR_RUN_TOKEN=
SUPERVISOR_RUN_ENABLED=true
SUPERVISOR_RUN_LIMIT=5
# Judging week: skip the demo token, keep the 5/hour limiter
SUPERVISOR_RUN_PUBLIC=false
