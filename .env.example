# Vertex / ADK (no Gemini API key — ADC via gcloud)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=cinetrace-ai
GOOGLE_CLOUD_LOCATION=us-central1

# Deployed Vertex Agent Engine. Set this and the supervisor runs the agents on
# the managed runtime; leave it empty and it runs the identical root_agent in
# process. Accepts a bare reasoningEngine id or a full resource path.
AGENT_ENGINE_ID=

# ClickHouse Cloud HTTPS (also used by stdio mcp-clickhouse)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_DATABASE=default

# Optional hosted MCP (OAuth). Agents use stdio mcp-clickhouse by default.
# CLICKHOUSE_MCP_URL=https://mcp.clickhouse.cloud/mcp

# Hosted Run supervisor gate (empty = fail closed unless SUPERVISOR_RUN_PUBLIC)
SUPERVISOR_RUN_TOKEN=
SUPERVISOR_RUN_ENABLED=true
SUPERVISOR_RUN_LIMIT=5
# Judging week: skip the demo token, keep the 5/hour limiter
SUPERVISOR_RUN_PUBLIC=false

# Live farm. The ticker writes one telemetry sample per in-flight job every
# LIVE_TICK_SECONDS, and rebuilds the last 48h of render_jobs against a fresh
# now() every LIVE_REFRESH_SECONDS so running jobs never age into zombies.
# Turn it off locally if you do not want a background writer.
LIVE_TICKER_ENABLED=true
LIVE_TICK_SECONDS=30
LIVE_REFRESH_SECONDS=900

# Hour (UTC) to clear proposals and decisions so the page shows unsolved waste
# again. -1 disables. Daily, not hourly: an approval should survive a session.
DEMO_RESET_HOUR_UTC=-1
